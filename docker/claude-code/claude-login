#!/usr/bin/expect -f
# claude-login: OAuth login helper for ttyd environments
#
# Spawns claude auth login in a real pty (so it prints the URL), then
# reads the auth code from /dev/tty using bash-compatible input.
#
# Usage: claude-login

set timeout 30
log_user 1

spawn env BROWSER=/bin/true claude auth login

# Set pty window size so Node.js/readline in claude sees non-zero dimensions
# (without this, process.stdout.columns == 0 and claude refuses to show its prompt)
stty rows 40 cols 200

# Wait for the OAuth URL to appear in pty output
expect {
    -re {(https://claude\.com/cai/oauth/\S+)} {
        set url $expect_out(1,string)
    }
    timeout {
        send_user "\nError: OAuth URL did not appear within 30s.\n"
        exit 1
    }
    eof {
        send_user "\nError: claude exited unexpectedly.\n"
        exit 1
    }
}

# Display URL prominently
send_user "\n"
send_user "╔══════════════════════════════════════════════════════╗\n"
send_user "║  Step 1 — Open this URL in your browser:            ║\n"
send_user "╚══════════════════════════════════════════════════════╝\n"
send_user "$url\n\n"

# Wait 2s for claude's "Paste code here" prompt to appear in the pty
# (we don't match it — ANSI codes in the prompt make glob unreliable)
after 2000

# Read auth code from /dev/tty (the real terminal — fully compatible with ttyd)
send_user "╔══════════════════════════════════════════════════════╗\n"
send_user "║  Step 2 — Paste your auth code below + Enter        ║\n"
send_user "╚══════════════════════════════════════════════════════╝\n"
send_user "▶ Auth code: "

set fd [open /dev/tty r]
gets $fd code
close $fd

# Strip all whitespace (trailing spaces/CR from browser paste in ttyd)
set code [string trim $code]

if {$code eq ""} {
    send_user "No code entered. Aborting.\n"
    exit 1
}

# Send code to the waiting claude process via pty
send "$code\r"

# Hand the terminal directly to claude so the user sees its full output
# and claude can handle any follow-up prompts naturally.
# When claude exits, interact returns and the script ends.
interact
