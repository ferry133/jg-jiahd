#!/bin/bash
# claude-login: OAuth login helper for ttyd environments
#
# 'claude auth login' uses raw terminal input incompatible with ttyd,
# making it impossible to type or paste the auth code. This script
# starts claude auth login in the background with a FIFO for stdin,
# then uses bash 'read' (fully compatible with ttyd) to accept the code.
#
# Usage: claude-login

FIFO=$(mktemp -u /tmp/claude-auth-XXXXXX)
mkfifo "$FIFO"
trap 'rm -f "$FIFO"; kill "$CLAUDE_PID" 2>/dev/null' EXIT

# Start claude auth login in background; stdin from FIFO, stdout/stderr
# go directly to terminal so the OAuth URL is visible
BROWSER=/bin/true claude auth login < "$FIFO" &
CLAUDE_PID=$!

# Wait for the URL to be printed on screen (appears in < 2s normally)
sleep 4

echo ""
echo "══════════════════════════════════════════════════════"
echo "  ↑  Copy the URL above and open it in your browser."
echo "  After you authorize and get the code, paste below."
echo "══════════════════════════════════════════════════════"
printf "\033[1;32m▶ Auth code: \033[0m"
IFS= read -r AUTH_CODE

if [ -z "$AUTH_CODE" ]; then
    echo "No code entered. Aborting."
    exit 1
fi

# Forward code to waiting claude process via FIFO
printf '%s\n' "$AUTH_CODE" > "$FIFO"

# Wait for claude to finish processing
wait "$CLAUDE_PID" 2>/dev/null || true

echo ""
echo "✓ Done! Run: claude"
