#!/bin/bash
# claude-login: OAuth login helper for ttyd environments
#
# Runs claude auth login directly in the user's terminal.
# Claude will print the OAuth URL — open it in your browser,
# authenticate, then paste the code when prompted.
#
# Usage: claude-login

printf '\n'
printf '╔══════════════════════════════════════════════════════╗\n'
printf '║  Claude Login — follow the steps below              ║\n'
printf '╚══════════════════════════════════════════════════════╝\n'
printf '  1. Copy the URL printed below into your browser\n'
printf '  2. Authenticate with your Anthropic account\n'
printf '  3. Paste the authorization code when prompted\n\n'

exec env BROWSER=/bin/true claude auth login
