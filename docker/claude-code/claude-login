#!/bin/bash
# claude-login: OAuth login helper for ttyd environments
#
# 'claude auth login' uses raw terminal input incompatible with ttyd.
# Root cause of previous versions: FIFO blocks the reader process on
# open() until a writer also opens it, so claude never started.
# Fix: open the write-end of the FIFO first (exec 3>FIFO), which
# unblocks claude immediately. Code is sent later via fd 3.
#
# Usage: claude-login

FIFO=$(mktemp -u /tmp/claude-auth-XXXXXX)
mkfifo "$FIFO"

# Open FIFO write-end NOW so the reader (claude) is not blocked on open()
exec 3>"$FIFO"
trap 'exec 3>&- 2>/dev/null; rm -f "$FIFO"; kill "$CLAUDE_PID" 2>/dev/null' EXIT

# Start claude auth login; stdin from FIFO (already open → starts immediately)
BROWSER=/bin/true claude auth login < "$FIFO" &
CLAUDE_PID=$!

# Wait for the OAuth URL to be printed (appears in < 2s)
sleep 4

echo ""
echo "══════════════════════════════════════════════════════"
echo "  ↑  Copy the URL above and open it in your browser."
echo "  After you authorize and get the code, paste below."
echo "══════════════════════════════════════════════════════"
printf "\033[1;32m▶ Auth code: \033[0m"
IFS= read -r AUTH_CODE

if [ -z "$AUTH_CODE" ]; then
    echo "No code entered. Aborting."
    exit 1
fi

# Send code to waiting claude process via write-end of FIFO
printf '%s\n' "$AUTH_CODE" >&3
exec 3>&-

# Wait for claude to finish processing
wait "$CLAUDE_PID" 2>/dev/null || true

echo ""
echo "✓ Done! Run: claude"
