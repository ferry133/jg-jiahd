#!/usr/bin/expect -f
# claude-login: OAuth login helper for ttyd environments
#
# Uses expect to spawn claude auth login inside a real pty so that
# claude prints the OAuth URL (it suppresses output when stdin is not
# a tty). The auth code is read from /dev/tty (the actual terminal)
# bypassing the pty, which works fine with ttyd's bash read.
#
# Usage: claude-login

set timeout 30
log_user 1

# Spawn claude inside a pty so it behaves interactively
spawn env BROWSER=/bin/true claude auth login

# Wait for the OAuth URL to appear
expect {
    -re {https://claude\.com/cai/oauth/\S+} {
        set url $expect_out(0,string)
    }
    timeout {
        send_user "\nError: OAuth URL did not appear within 30s.\n"
        exit 1
    }
    eof {
        send_user "\nError: claude exited unexpectedly.\n"
        exit 1
    }
}

# Show URL prominently
send_user "\n"
send_user "╔══════════════════════════════════════════════════════╗\n"
send_user "║  Step 1 — Open this URL in your browser:            ║\n"
send_user "╚══════════════════════════════════════════════════════╝\n"
send_user "$url\n"
send_user "\n"

# Wait for the code prompt from claude
expect {
    -glob "*Paste code here*" { }
    timeout {
        send_user "Error: code prompt did not appear.\n"
        exit 1
    }
}

# Read auth code from /dev/tty (the real terminal — works with ttyd)
send_user "╔══════════════════════════════════════════════════════╗\n"
send_user "║  Step 2 — Paste your auth code below and press Enter ║\n"
send_user "╚══════════════════════════════════════════════════════╝\n"
send_user "▶ Auth code: "

set fd [open /dev/tty r]
gets $fd code
close $fd

# Send code to the waiting claude process
send "$code\r"

# Wait for completion
expect {
    -glob "*Login successful*" {
        send_user "\n✓ Login successful! Run: claude\n"
    }
    eof {
        send_user "\n✓ Done. Run: claude\n"
    }
    timeout {
        send_user "\nTimeout waiting for login confirmation.\n"
    }
}
