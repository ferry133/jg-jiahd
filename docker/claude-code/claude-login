#!/usr/bin/env python3
"""
claude-login: runs `claude`, intercepts the hard-wrapped OAuth URL lines,
reconstructs the full URL, and emits it as a SINGLE logical line wrapped in
OSC 8.  xterm.js keeps all soft-wrapped characters under one hyperlink, so the
whole URL is clickable regardless of how many visual lines it occupies.

Also strips the built-in "(c to copy)" hint to prevent xterm.js from echoing
old clipboard content into the terminal input as a spurious auth code.
"""
import os, sys, re, pty, tty, select, signal, termios, fcntl, struct

# Specific enough to avoid false positives
URL_START = b'https://claude.com/cai/oauth/'

# Remove "(c to copy)" and the cursor-movement escapes that precede it.
# Without this, pressing c triggers an OSC-52 clipboard read-back that feeds
# the previous clipboard contents into the "Paste code here" prompt.
COPY_HINT_RE = re.compile(
    rb'(?:\x1b\[[0-9;]*[A-Za-z])*'  # zero-or-more ANSI cursor/attr seqs
    rb'[^\x1b\r\n]*'                 # any plain chars (e.g. spaces)
    rb'\(c to copy\)'                # the hint text
    rb'(?:\x1b\[[0-9;]*[A-Za-z])*'  # trailing ANSI seqs
)


def osc8(url: bytes) -> bytes:
    return b'\x1b]8;;' + url + b'\x07' + url + b'\x1b]8;;\x07'


def url_box(url: bytes) -> bytes:
    """Format the full URL as a single OSC 8 hyperlink inside a labelled box."""
    rule = b'\xe2\x94\x80' * 62           # ── repeated
    top  = b'\r\n\x1b[36m\xe2\x94\x8c' + rule + b'\x1b[0m\r\n'
    lbl  = b'\x1b[36m\xe2\x94\x82\x1b[0m \x1b[1mClick the URL below (the whole URL is one link):\x1b[0m\r\n'
    body = b'\x1b[36m\xe2\x94\x82\x1b[0m \x1b[1;33m' + osc8(url) + b'\x1b[0m\r\n'
    bot  = b'\x1b[36m\xe2\x94\x94' + rule + b'\x1b[0m\r\n\r\n'
    return top + lbl + body + bot


class URLFilter:
    """
    Passes all output through unchanged except for the URL section:
    - Buffers hard-wrapped URL lines until the section ends
    - Emits url_box() first (single OSC 8 line), then the original lines
    """
    IDLE, COLLECTING, DONE = range(3)

    def __init__(self):
        self.state = self.IDLE
        self.parts = []   # stripped URL chunks
        self.orig  = []   # original line bytes (including \r\n)
        self.buf   = b''  # partial-line carry buffer

    def feed(self, raw: bytes) -> bytes:
        raw = COPY_HINT_RE.sub(b'', raw)  # strip (c to copy) hint first
        self.buf += raw
        out = bytearray()

        while True:
            i = self.buf.find(b'\r\n')
            if i < 0:
                # No complete line yet.
                # In IDLE/DONE pass partial content through immediately.
                if self.state != self.COLLECTING:
                    out += self.buf
                    self.buf = b''
                break

            line, self.buf = self.buf[:i], self.buf[i + 2:]

            if self.state == self.DONE:
                out += line + b'\r\n'

            elif self.state == self.IDLE:
                text = line.lstrip(b' ')
                if text.startswith(URL_START):
                    self.state = self.COLLECTING
                    self.parts = [text]
                    self.orig  = [line + b'\r\n']
                else:
                    out += line + b'\r\n'

            else:  # COLLECTING
                s = line.strip()
                # URL continuation: no spaces, no escape sequences, not empty
                if s and b' ' not in s and b'\x1b' not in s:
                    self.parts.append(s)
                    self.orig.append(line + b'\r\n')
                else:
                    # URL section complete — emit box then original lines
                    out += url_box(b''.join(self.parts))
                    for orig_line in self.orig:
                        out += orig_line
                    self.parts = []
                    self.orig  = []
                    self.state = self.DONE
                    out += line + b'\r\n'

        return bytes(out)

    def flush(self) -> bytes:
        out = bytearray()
        if self.parts:
            out += url_box(b''.join(self.parts))
            for orig_line in self.orig:
                out += orig_line
        out += self.buf
        return bytes(out)


# ── PTY plumbing ──────────────────────────────────────────────────────────────

def winsize(fd: int):
    try:
        r, c = struct.unpack('HHHH', fcntl.ioctl(fd, termios.TIOCGWINSZ, b'\x00' * 8))[:2]
        return r, c
    except OSError:
        return 24, 80


def set_winsize(fd: int, rows: int, cols: int):
    try:
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', rows, cols, 0, 0))
    except OSError:
        pass


master_fd, slave_fd = pty.openpty()
rows, cols = winsize(sys.stdout.fileno())
set_winsize(master_fd, rows, cols)

pid = os.fork()
if pid == 0:
    os.close(master_fd)
    os.setsid()
    fcntl.ioctl(slave_fd, termios.TIOCSCTTY, 0)
    for fd in range(3):
        os.dup2(slave_fd, fd)
    os.close(slave_fd)
    os.execvpe('claude', ['claude'], os.environ)
    sys.exit(1)

os.close(slave_fd)

filt = URLFilter()


def on_winch(_sig, _frame):
    r, c = winsize(sys.stdout.fileno())
    set_winsize(master_fd, r, c)
    os.kill(pid, signal.SIGWINCH)


signal.signal(signal.SIGWINCH, on_winch)

stdin_fd   = sys.stdin.fileno()
old_attrs  = termios.tcgetattr(stdin_fd)
tty.setraw(stdin_fd)

try:
    while True:
        try:
            rfds, _, _ = select.select([master_fd, stdin_fd], [], [], 0.05)
        except (ValueError, OSError):
            break
        if master_fd in rfds:
            try:
                chunk = os.read(master_fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            os.write(sys.stdout.fileno(), filt.feed(chunk))
        if stdin_fd in rfds:
            try:
                data = os.read(stdin_fd, 4096)
                if data:
                    os.write(master_fd, data)
            except OSError:
                break
finally:
    termios.tcsetattr(stdin_fd, termios.TCSADRAIN, old_attrs)
    sys.stdout.buffer.write(filt.flush())
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass
